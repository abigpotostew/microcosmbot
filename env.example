# Database
# Example: postgresql://user:password@localhost:5432/dbname
DATABASE_URL=

# Alchemy (for Ethereum integration)
NEXT_PUBLIC_ALCHEMY_ID=

# Bot Configuration
NEXT_PUBLIC_BOT_DAO=
TELEGRAM_BOT_KEY=
NEXT_PUBLIC_GETME_BOT_INFO=

# Blockchain Configuration
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_CHAINNAME=
NEXT_PUBLIC_CHAINRESTURL=
NEXT_PUBLIC_NETWORK=
NEXT_PUBLIC_CHAINID=

# Application URLs
BASEURL=http://localhost:3000

# WalletConnect
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=


# Security & Secrets
TG_WEBHOOK_SECRET=

# Optional Configuration
MAINTENANCE_MODE=0
DISABLE_AUDIT_LOGS=false
ALLOWED_DENOMS=

# Monitoring
SLACK_MONITOR_WEBHOOK=

# Node Environment
NODE_ENV=production

# Docker Network Configuration (for docker-compose)
# Set to your external network name if connecting to existing network (e.g., database network)
# Example: DOCKER_NETWORK=microcosmbot-mysql-database-ugcs00ckso4008o40wc04g8w
DOCKER_NETWORK=microcosms_default
# Set to true if using an existing external network, false to create a new one
DOCKER_NETWORK_EXTERNAL=false

